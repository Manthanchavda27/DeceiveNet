# Copy to .env and adjust. Local docker-compose matches defaults below.
DATABASE_URL=postgresql://deceivenet:deceivenet@localhost:5432/deceivenet
REDIS_URL=redis://localhost:6379/0
RABBITMQ_URL=amqp://deceivenet:deceivenet@localhost:5672
TIMESERIES_URL=http://localhost:8086
S3_ENDPOINT=http://127.0.0.1:9000
S3_ACCESS_KEY=deceivenet
S3_SECRET_KEY=deceivenet_secret
S3_BUCKET=deceivenet-payloads

JWT_SECRET=change-me-in-production-min-32-chars-long
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
BCRYPT_COST=12
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173,https://deceivenet.netlify.app

# Rate limits (per minute) — API gateway
RATE_LIMIT_ANONYMOUS=30
RATE_LIMIT_AUTHENTICATED=120
RATE_LIMIT_API_KEY=300
