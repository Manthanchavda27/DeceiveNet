// DeceiveNet — PostgreSQL schema (transactional core). Time-series hot metrics use Redis rollups;
// optional Timescale/Influx integration via EVENT_PIPELINE later.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url = "file:./dev.db"
}































model User {
  id            String     @id @default(uuid()) 
  username      String     @unique
  email         String     @unique
  passwordHash  String     @map("password_hash")
  role          String
  status        String @default("active")
  mfaEnabled    Boolean    @default(false) @map("mfa_enabled")
  mfaSecret     String?    @map("mfa_secret")
  createdAt     DateTime   @default(now()) @map("created_at")
  lastLoginAt   DateTime?  @map("last_login_at")
  failedAttempts Int       @default(0) @map("failed_attempts")
  lockoutUntil  DateTime?  @map("lockout_until")

  refreshTokens  RefreshToken[]
  apiKeys        ApiKey[]
  eventComments  EventComment[]
  alertRules     AlertRule[]     @relation("RuleAuthor")
  sessions       WsSession[]
  savedSearches  SavedSearch[]
  notificationLogs NotificationLog[]
  settingsUpdates  Settings[] @relation("SettingsUpdatedBy")
  honeypots        Honeypot[]
  webhooks         Webhook[]
}

model RefreshToken {
  id         String   @id @default(uuid()) 
  userId     String   @map("user_id") 
  tokenHash  String   @map("token_hash")
  expiresAt  DateTime @map("expires_at")
  revoked    Boolean  @default(false)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model ApiKey {
  id           String    @id @default(uuid()) 
  userId       String    @map("user_id") 
  name         String
  keyPrefix    String    @map("key_prefix")
  keyHash      String    @map("key_hash")
  permissions  Json      @default("[]")
  expiresAt    DateTime? @map("expires_at")
  lastUsedAt   DateTime? @map("last_used_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  allowedIps   Json?     @map("allowed_ips")
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([keyHash])
}

model Honeypot {
  id           String          @id @default(uuid()) 
  name         String
  type         String
  status       String
  config       Json
  apiKey       String          @unique @default(uuid()) @map("api_key")
  bindAddress  String?         @map("bind_address")
  port         Int?
  tags         String        @default("[]")
  deployedAt   DateTime?       @map("deployed_at")
  lastActiveAt DateTime?       @map("last_active_at")
  containerId  String?         @map("container_id")
  metadata     Json?

  userId       String          @map("user_id")
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  decoyServices DecoyService[]
  events        Event[]
  payloads      Payload[]
}

model DecoyService {
  id           String     @id @default(uuid()) 
  honeypotId   String?    @map("honeypot_id") 
  name         String
  serviceType  String     @map("service_type")
  port         Int
  banner       String?
  credentials  Json?
  enabled      Boolean    @default(true)
  config       Json?
  createdAt    DateTime   @default(now()) @map("created_at")

  honeypot Honeypot?       @relation(fields: [honeypotId], references: [id], onDelete: Cascade)
  sessions DecoySession[]
  events   Event[]
}

model DecoySession {
  id                String             @id @default(uuid()) 
  decoyServiceId    String             @map("decoy_service_id") 
  attackerIp        String             @map("attacker_ip")
  sourcePort        Int                @map("source_port")
  sessionId         String             @unique @map("session_id") 
  protocol          String
  startedAt         DateTime           @map("started_at")
  lastActiveAt      DateTime           @map("last_active_at")
  endedAt           DateTime?          @map("ended_at")
  commandsExecuted  Int                @default(0) @map("commands_executed")
  dataTransferred   BigInt             @default(0) @map("data_transferred")
  status            String
  metadata          Json?

  decoyService DecoyService @relation(fields: [decoyServiceId], references: [id], onDelete: Cascade)
  events       Event[]
}

model Event {
  id               String            @id @default(uuid()) 
  eventUuid        String            @unique @map("event_uuid") 
  honeypotId       String?           @map("honeypot_id") 
  decoyServiceId   String?           @map("decoy_service_id") 
  decoySessionId   String?           @map("decoy_session_id") 
  timestamp        DateTime
  severity         String
  severityScore    Int?              @map("severity_score")
  attackType       String        @map("attack_type")
  sourceIp         String            @map("source_ip")
  sourcePort       Int?              @map("source_port")
  sourceGeo        Json?             @map("source_geo")
  targetPort       Int?              @map("target_port")
  protocol         String
  status           String @default("new")
  payloadId        String?           @map("payload_id") 
  rawData          Json?             @map("raw_data")
  enrichedData     Json?             @map("enriched_data")
  tags             String          @default("[]")
  notes            String?
  assignedTo       String?           @map("assigned_to") 

  honeypot     Honeypot?      @relation(fields: [honeypotId], references: [id], onDelete: Cascade)
  decoyService DecoyService?  @relation(fields: [decoyServiceId], references: [id], onDelete: SetNull)
  decoySession DecoySession?  @relation(fields: [decoySessionId], references: [id], onDelete: SetNull)
  payload      Payload?       @relation(fields: [payloadId], references: [id], onDelete: SetNull)
  comments     EventComment[]

  @@index([timestamp])
  @@index([honeypotId])
  @@index([severity])
  @@index([attackType])
  @@index([sourceIp])
  @@index([status])
}

model EventComment {
  id        String   @id @default(uuid()) 
  eventId   String   @map("event_id") 
  userId    String   @map("user_id") 
  comment   String
  createdAt DateTime @default(now()) @map("created_at")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Payload {
  id              String       @id @default(uuid()) 
  payloadUuid     String       @unique @map("payload_uuid") 
  type            String
  raw             Bytes?
  textContent     String?      @map("text_content")
  sizeBytes       BigInt       @map("size_bytes")
  md5             String       
  sha1            String       
  sha256          String       
  entropy         Float
  mimeType        String?      @map("mime_type")
  languageDetected String?     @map("language_detected")
  decodedText     String?      @map("decoded_text")
  honeypotId      String?      @map("honeypot_id") 
  sourceIp        String       @map("source_ip")
  capturedAt      DateTime     @map("captured_at")
  analysis        Json?

  honeypot Honeypot? @relation(fields: [honeypotId], references: [id], onDelete: Cascade)
  events   Event[]

  @@index([sha256])
  @@index([md5])
  @@index([capturedAt])
}

model AlertRule {
  id                     String         @id @default(uuid()) 
  name                   String
  description            String?
  severity               String
  conditions             Json
  frequencyCount         Int            @map("frequency_count")
  frequencyWindowMinutes Int            @map("frequency_window_minutes")
  enabled                Boolean        @default(true)
  notificationChannels   Json           @map("notification_channels")
  createdById            String         @map("created_by") 
  createdAt              DateTime       @default(now()) @map("created_at")
  updatedAt              DateTime       @updatedAt @map("updated_at")
  lastTriggeredAt        DateTime?      @map("last_triggered_at")

  author  User           @relation("RuleAuthor", fields: [createdById], references: [id])
  history AlertHistory[]
}

model AlertHistory {
  id             String              @id @default(uuid()) 
  alertRuleId    String              @map("alert_rule_id") 
  triggeredAt    DateTime            @map("triggered_at")
  eventIds       String            @map("event_ids")
  severity       String
  status         String  @default("unacknowledged")
  acknowledgedBy String?            @map("acknowledged_by") 
  acknowledgedAt DateTime?           @map("acknowledged_at")
  notes          String?

  rule AlertRule @relation(fields: [alertRuleId], references: [id], onDelete: Cascade)
}

model Webhook {
  id                 String   @id @default(uuid()) 
  name               String
  url                String
  userId             String   @map("user_id")
  secretEnc          String   @map("secret")
  eventsSubscribed   String @map("events_subscribed")
  enabled            Boolean  @default(true)
  retryCount         Int      @default(3) @map("retry_count")
  timeoutSeconds     Int      @default(30) @map("timeout_seconds")
  headers            Json?
  rateLimitPerMinute Int      @default(60) @map("rate_limit_per_minute")
  createdAt          DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveryLogs WebhookDeliveryLog[]
}

model WebhookDeliveryLog {
  id            String   @id @default(uuid()) 
  webhookId     String   @map("webhook_id") 
  eventType     String   @map("event_type")
  eventId       String   @map("event_id")
  requestBody   Json     @map("request_body")
  responseStatus Int?    @map("response_status")
  responseBody  String?  @map("response_body")
  errorMessage  String?  @map("error_message")
  attemptedAt   DateTime @map("attempted_at")
  success       Boolean
  attemptNumber Int      @map("attempt_number")
  durationMs    Int?     @map("duration_ms")

  webhook Webhook @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@index([webhookId])
  @@index([attemptedAt])
}

model ThreatIndicator {
  id             String              @id @default(uuid()) 
  value          String
  type           String
  confidence     Int
  severity       String
  firstSeen      DateTime            @map("first_seen")
  lastSeen       DateTime            @map("last_seen")
  tags           String            @default("[]")
  source         String
  sourceEventId  String?             @map("source_event_id") 
  threatActorId  String?             @map("threat_actor_id") 
  enrichmentData Json?               @map("enrichment_data")
  notes          String?

  actor ThreatActor? @relation(fields: [threatActorId], references: [id], onDelete: SetNull)

  @@unique([value, type])
  @@index([lastSeen])
}

model ThreatActor {
  id                  String          @id @default(uuid()) 
  name                String
  firstSeen           DateTime        @map("first_seen")
  lastSeen            DateTime        @map("last_seen")
  attackCount         Int             @default(0) @map("attack_count")
  primaryAttackTypes  String        @map("primary_attack_types")
  commonIps           String        @map("common_ips")
  targetedServices    String        @map("targeted_services")
  confidence          String
  profileData         Json?           @map("profile_data")
  notes               String?

  indicators ThreatIndicator[]
}

model AuditLog {
  id          String      @id @default(uuid()) 
  userId      String?     @map("user_id") 
  username    String
  action      String
  resourceType String     @map("resource_type")
  resourceId  String      @map("resource_id")
  details     Json?
  ipAddress   String?     @map("ip_address")
  userAgent   String?     @map("user_agent")
  timestamp   DateTime    @default(now())
  tamperHash  String      @map("tamper_hash")

  @@index([timestamp])
  @@index([userId])
  @@index([action])
}

model WsSession {
  id               String   @id @default(uuid()) 
  userId           String   @map("user_id") 
  wsConnectionId   String   @unique @map("ws_connection_id")
  connectedAt      DateTime @map("connected_at")
  lastHeartbeat    DateTime @map("last_heartbeat")
  metadata         Json?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Settings {
  key       String   @id
  value     Json
  updatedBy String   @map("updated_by") 
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation("SettingsUpdatedBy", fields: [updatedBy], references: [id])
}

model SavedSearch {
  id           String   @id @default(uuid()) 
  userId       String   @map("user_id") 
  name         String
  searchConfig Json     @map("search_config")
  createdAt    DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model NotificationLog {
  id        String                 @id @default(uuid()) 
  userId    String?                @map("user_id") 
  channel   String
  template  String
  subject   String?
  body      String
  status    String
  error     String?
  sentAt    DateTime               @map("sent_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
}
